# Configuration de production
# ⚠️ Ce fichier est un template - copiez-le en .env.local sur votre serveur de production
# et complétez les valeurs manquantes (notamment le mot de passe de la base de données)

# Environnement
APP_ENV=prod
APP_DEBUG=0

# Clé secrète de l'application (générée automatiquement)
# Vous pouvez en générer une nouvelle avec : php -r "echo bin2hex(random_bytes(16));"
APP_SECRET=6f23635b7e95a589ebb79c9894cd9219

# Base de données MySQL
# ⚠️ REMPLACEZ 'VOTRE_MOT_DE_PASSE' par le mot de passe réel de votre base de données
DATABASE_URL="mysql://profeszoffice:VOTRE_MOT_DE_PASSE@profeszoffice.mysql.db:3306/profeszoffice?serverVersion=8.0.32&charset=utf8mb4"

# Messenger (tâches asynchrones)
MESSENGER_TRANSPORT_DSN=doctrine://default?auto_setup=0

# Mailer (optionnel - à configurer selon votre hébergeur)
# MAILER_DSN=smtp://user:pass@smtp.example.com:587

# URL publique du site (à adapter selon votre domaine)
# DEFAULT_URI=https://votredomaine.com

# Super Admin (optionnel - pour créer automatiquement un admin)
# SUPER_ADMIN_EMAIL=admin@votredomaine.com
# SUPER_ADMIN_PASSWORD=votre_mot_de_passe_securise

# Webhook PrintAudit (optionnel - si vous utilisez les webhooks)
# PRINTAUDIT_WEBHOOK_TOKEN=votre_token_secret_webhook

# Microsoft 365 / Graph API (optionnel - si vous synchronisez les contacts)
# M365_TENANT_ID=votre-tenant-id
# M365_CLIENT_ID=votre-client-id
# M365_CLIENT_SECRET=votre-client-secret
# M365_REDIRECT_URI=https://votredomaine.com/m365/callback

# Import IMAP (optionnel - pour l'import automatique d'emails)
